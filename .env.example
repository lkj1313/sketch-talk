# Docker Compose에서 실행하는 로컬 PostgreSQL 설정
POSTGRES_USER=sketch_talk
POSTGRES_PASSWORD=sketch_talk_local_password
POSTGRES_DB=sketch_talk
POSTGRES_PORT=5432

# 추후 Prisma에서 사용할 연결 주소
DATABASE_URL=postgresql://sketch_talk:sketch_talk_local_password@localhost:5432/sketch_talk?schema=public

# JWT Access Token 서명 키
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_MODEL=kimi-for-coding

# 서버 시작 시 부족분 생성 및 매주 월요일 오전 3시 제시어 교체
WORD_AUTO_GENERATION_ENABLED=false
