generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(320)
  passwordHash    String           @db.VarChar(255)
  nickname        String           @unique @db.VarChar(30)
  avatarUrl       String?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authSessions    AuthSession[]
  roomParticipant RoomParticipant?
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
  CLOSED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum WordDifficulty {
  EASY
  MEDIUM
  HARD
}

enum GameSessionStatus {
  PLAYING
  FINISHED
  CANCELLED
}

enum GameRoundStatus {
  DRAWING
  FINISHED
  SKIPPED
}

model Word {
  id               String         @id @default(uuid()) @db.Uuid
  answer           String         @db.VarChar(50)
  normalizedAnswer String         @unique @db.VarChar(50)
  category         String         @default("전체") @db.VarChar(30)
  difficulty       WordDifficulty
  isActive         Boolean        @default(true)
  usageCount       Int            @default(0)
  lastUsedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rounds           GameRound[]

  @@index([difficulty, isActive])
}

model Room {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique @db.VarChar(8)
  title             String            @db.VarChar(50)
  status            RoomStatus        @default(WAITING)
  visibility        RoomVisibility    @default(PUBLIC)
  maxPlayers        Int               @default(8) @db.SmallInt
  allowMidJoin      Boolean           @default(true)
  hostParticipantId String?           @unique @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  startedAt         DateTime?
  endedAt           DateTime?
  hostParticipant   RoomParticipant?  @relation("RoomHost", fields: [hostParticipantId], references: [id], onDelete: SetNull)
  participants      RoomParticipant[] @relation("RoomParticipants")
  gameSessions      GameSession[]

  @@index([visibility, status, createdAt])
}

model RoomParticipant {
  id             String        @id @default(uuid()) @db.Uuid
  roomId         String        @db.Uuid
  userId         String?       @unique @db.Uuid
  guestSessionId String?       @unique @db.Uuid
  nickname       String        @db.VarChar(30)
  score          Int           @default(0)
  isReady        Boolean       @default(false)
  joinedAt       DateTime      @default(now())
  room           Room          @relation("RoomParticipants", fields: [roomId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  hostedRoom     Room?         @relation("RoomHost")
  drawnRounds    GameRound[]   @relation("GameRoundDrawer")
  guessedRounds  GameRound[]   @relation("GameRoundGuesser")

  @@index([roomId])
}

model GameSession {
  id                 String            @id @default(uuid()) @db.Uuid
  roomId             String?           @db.Uuid
  roomCode           String            @db.VarChar(8)
  roomTitle          String            @db.VarChar(50)
  status             GameSessionStatus @default(PLAYING)
  totalRounds        Int               @default(10) @db.SmallInt
  currentRoundNumber Int               @default(0) @db.SmallInt
  startedAt          DateTime          @default(now())
  endedAt            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  room               Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  rounds             GameRound[]

  @@index([roomId, status, startedAt])
}

model GameRound {
  id                     String           @id @default(uuid()) @db.Uuid
  gameSessionId          String           @db.Uuid
  wordId                 String           @db.Uuid
  drawerParticipantId    String?          @db.Uuid
  guessedByParticipantId String?          @db.Uuid
  roundNumber            Int              @db.SmallInt
  status                 GameRoundStatus  @default(DRAWING)
  answerSnapshot         String           @db.VarChar(50)
  difficultySnapshot     WordDifficulty
  guesserScore           Int              @default(0)
  drawerScore            Int              @default(0)
  startedAt              DateTime         @default(now())
  endedAt                DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  gameSession            GameSession      @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  word                   Word             @relation(fields: [wordId], references: [id], onDelete: Restrict)
  drawerParticipant      RoomParticipant? @relation("GameRoundDrawer", fields: [drawerParticipantId], references: [id], onDelete: SetNull)
  guessedByParticipant   RoomParticipant? @relation("GameRoundGuesser", fields: [guessedByParticipantId], references: [id], onDelete: SetNull)

  @@unique([gameSessionId, roundNumber])
  @@unique([gameSessionId, wordId])
  @@index([wordId])
  @@index([drawerParticipantId])
  @@index([guessedByParticipantId])
}

model GuestSession {
  id          String           @id @default(uuid()) @db.Uuid
  tokenHash   String           @unique @db.VarChar(64)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())
  participant RoomParticipant?
}
